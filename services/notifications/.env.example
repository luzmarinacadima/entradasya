# Variables de entorno de notifications (desarrollo local).
# Copia este archivo como .env  (npm run dev lo hace solo si no existe)
# Nombre que aparece en los logs
SERVICE_NAME=notifications
# Puerto HTTP del servicio
PORT=3006
# debug, info, warn o error
LOG_LEVEL=info
# Token para llamadas entre servicios (igual en todos)
INTERNAL_TOKEN=dev-internal-token-cambiar
# Servidor SMTP (Mailpit)
SMTP_HOST=localhost
# Puerto SMTP de Mailpit
SMTP_PORT=1025
# SMTP con TLS
SMTP_SECURE=false
# Mailpit no usa TLS
SMTP_IGNORE_TLS=true
# Tiempo máximo de conexión SMTP
SMTP_TIMEOUT_MS=5000
# Remitente
MAIL_FROM=EntradasYa <no-reply@entradasya.local>
# Zona horaria de las fechas
EVENT_TIMEZONE=America/La_Paz
