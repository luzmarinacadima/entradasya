# Variables de entorno de orders (desarrollo local).
# Copia este archivo como .env  (npm run dev lo hace solo si no existe)
# Nombre que aparece en los logs
SERVICE_NAME=orders
# Puerto HTTP del servicio
PORT=3003
# debug, info, warn o error
LOG_LEVEL=info
# Servidor PostgreSQL
DB_HOST=localhost
# Puerto PostgreSQL
DB_PORT=5432
# Base de datos PROPIA del servicio
DB_NAME=orders_db
# Usuario PROPIO del servicio
DB_USER=orders_user
# Contraseña (en el servidor se genera una aleatoria)
DB_PASSWORD=orders_dev_pass
# Secreto compartido para firmar/validar JWT (igual en todos)
JWT_SECRET=dev-jwt-secret-cambiar
# Token para llamadas entre servicios (igual en todos)
INTERNAL_TOKEN=dev-internal-token-cambiar
# Tiempo máximo de espera al llamar a otro servicio
HTTP_TIMEOUT_MS=5000
# URL de events
EVENTS_URL=http://localhost:3002
# URL de payments
PAYMENTS_URL=http://localhost:3004
# URL de tickets
TICKETS_URL=http://localhost:3005
# URL de notifications
NOTIFICATIONS_URL=http://localhost:3006
# Tiempo máximo para generar los PDF
TICKETS_TIMEOUT_MS=15000
# URL pública de la web (para el enlace del correo)
PUBLIC_URL=http://localhost:5173
