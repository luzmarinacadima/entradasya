# Variables de entorno de auth (desarrollo local).
# Copia este archivo como .env  (npm run dev lo hace solo si no existe)
# Nombre que aparece en los logs
SERVICE_NAME=auth
# Puerto HTTP del servicio
PORT=3001
# debug, info, warn o error
LOG_LEVEL=info
# Servidor PostgreSQL
DB_HOST=localhost
# Puerto PostgreSQL
DB_PORT=5432
# Base de datos PROPIA del servicio
DB_NAME=auth_db
# Usuario PROPIO del servicio
DB_USER=auth_user
# Contraseña (en el servidor se genera una aleatoria)
DB_PASSWORD=auth_dev_pass
# Secreto compartido para firmar/validar JWT (igual en todos)
JWT_SECRET=dev-jwt-secret-cambiar
# Duración del token en segundos (8 h)
JWT_EXPIRES_IN_S=28800
# Permite registrarse como organizador/portero (útil en clase)
ALLOW_ROLE_SIGNUP=true
